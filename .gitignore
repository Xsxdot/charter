# 前端依赖与增量构建缓存：本地产物，不进仓。
# graph/webui/dist 是例外——它由 webui.go 以 go:embed 嵌入，必须提交。
graph/webui/node_modules/
graph/webui/*.tsbuildinfo

# Claude Code 本地配置与工作树：包含机器路径和运行时产物，不进仓。
.claude/launch.json
.claude/settings.local.json
.claude/worktrees/

# Python 字节码缓存：py_compile / 导入时生成的本地产物。
__pycache__/
*.pyc
