{
  "nodes": [
    {
      "name": "待办",
      "next": "spec"
    },
    {
      "name": "spec",
      "next": "plan"
    },
    {
      "name": "plan",
      "template": "charter-story-default",
      "override": {
        "discipline": "charter-story-plan",
        "squad": "pro"
      },
      "dispatch": true,
      "verdict": true,
      "carry_card_context": true,
      "max_rounds": 3,
      "omit_acceptance": true,
      "produces": {
        "kind": "plan",
        "path": "docs/superpowers/plans/{{CARD_LOWER}}-plan.md"
      },
      "next": "implement"
    },
    {
      "name": "implement",
      "template": "charter-story-default",
      "override": {
        "discipline": "charter-story-implement",
        "squad": "runner"
      },
      "dispatch": true,
      "verdict": true,
      "carry_card_context": true,
      "max_rounds": 3,
      "next": "review",
      "on_fail": "plan",
      "gate": {
        "require_attachment": "plan"
      }
    },
    {
      "name": "review",
      "template": "charter-story-default",
      "override": {
        "discipline": "charter-story-review",
        "squad": "pro"
      },
      "dispatch": true,
      "verdict": true,
      "carry_card_context": true,
      "max_rounds": 3,
      "next": "finish",
      "on_fail": "implement"
    },
    {
      "name": "finish",
      "next": "已完成",
      "gate": {
        "require_children_done": true
      }
    },
    {
      "name": "已完成"
    }
  ],
  "board": {
    "columns": [
      "代办",
      "沟通中",
      "进行中",
      "审核中",
      "结束"
    ],
    "state_to_column": {
      "finish": "结束",
      "implement": "进行中",
      "plan": "进行中",
      "review": "审核中",
      "spec": "沟通中",
      "已出 spec": "沟通中",
      "已出spec": "沟通中",
      "已完成": "结束",
      "待办": "代办",
      "待合并": "审核中",
      "待审阅": "审核中",
      "终止": "结束",
      "进行中": "进行中"
    },
    "fallback": "进行中"
  }
}
